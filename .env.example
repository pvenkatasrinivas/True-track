# Copy the values you need into your terminal or IDE run configuration.
# Never commit real passwords or secrets.

# Backend (required)
DB_PASSWORD=your_postgres_password_here
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Backend (optional - defaults shown)
DB_URL=jdbc:postgresql://localhost:5432/truetrack
DB_USERNAME=postgres
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# Frontend (put in frontend/.env only if the backend is not on localhost:8080)
VITE_API_BASE_URL=http://localhost:8080
